<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rtk_global</name>
  <version>0.1.0</version>
  <description>Quality-aware RTK/GNSS position constraints for GLIM global mapping (glim_ext module)</description>
  <maintainer email="meitiever@gmail.com">steve</maintainer>
  <license>GPLv3</license>

  <!-- Built as a sub-directory of glim_ext (add_subdirectory); this file exists so that
       ament_auto_find_build_dependencies() in the module CMakeLists can read its deps. -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>glim</depend>
  <depend>gnss_core</depend>
  <depend>gnss_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
